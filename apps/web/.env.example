# Copie para .env.local e preencha. Nunca suba o .env.local para o GitHub.

# Chave do GitHub (fine-grained token) com acesso só ao repositório, permissões Contents e Pages: leitura e escrita
GITHUB_TOKEN=
# dono/nome do repositório onde ficam os dados e o site publicado
GITHUB_REPO=RenanPrates/publicadorNorte
# branch dos dados dos eventos (HTMLs-modelo, cadastro, mídia)
GITHUB_BRANCH_DADOS=dados
# branch servida pelo GitHub Pages (sites publicados)
GITHUB_BRANCH_SITE=gh-pages

# Senha única da equipe para abrir o publicador (usuário: qualquer um)
SENHA_EQUIPE=

# Automação: o cron da Cloudflare chama /api/automacao a cada 5 minutos. Opcional:
# sem esta chave, ela é derivada do GITHUB_TOKEN. Só preencha para chamar a rota de fora (ex.: testes).
AUTOMACAO_TOKEN=

# Produção (domínios próprios dos eventos). Opcional: sem estas duas, o passo Publicar mostra como ligar o domínio à mão.
# Token da Cloudflare com: Account > Workers Scripts: Edit; Zone > Workers Routes: Edit; Zone > DNS: Edit; Zone > Zone: Read
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# nome do Worker do publicador na Cloudflare (padrão: publicador-norte)
CLOUDFLARE_WORKER=
# outros endereços do painel além de *.workers.dev e localhost (separados por vírgula), ex.: publicador.nortemkt.com.br
PUBLICADOR_HOSTS=

# Odoo (preços, links e distâncias dos combos; passo Cadastro > Preços do Odoo). Opcional.
# Chave de API do Odoo 19 (usuário com leitura de produtos, eventos e listas de preço). Na Cloudflare, cadastre como Secret.
ODOO_URL=https://beta.runningland.com.br
ODOO_API_KEY=
# lista de preço do O2 Prime (padrão 4)
ODOO_PRIME_PRICELIST_ID=4
# só se o servidor do Odoo tiver mais de um banco; nome errado faz o Odoo responder 404
ODOO_DB=
