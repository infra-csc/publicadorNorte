{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "publicador-norte",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // automação a cada 5 minutos (publicações agendadas e status "realizado"): worker.ts → scheduled → /api/automacao
  "triggers": { "crons": ["*/5 * * * *"] },
  // worker.ts: os domínios dos sites em produção são servidos antes do Next (lib/servidor/sitesProducao.ts)
  // configurações sem segredo; GITHUB_TOKEN, SENHA_EQUIPE, CLOUDFLARE_API_TOKEN e ODOO_API_KEY entram como "secrets".
  // Cada deploy troca as variáveis de texto do painel por estas: variável comum criada no painel some no deploy seguinte.
  "vars": {
    "GITHUB_REPO": "RenanPrates/publicadorNorte",
    "GITHUB_BRANCH_DADOS": "dados",
    "GITHUB_BRANCH_SITE": "gh-pages",
    "ODOO_URL": "https://beta.runningland.com.br",
    "ODOO_PRIME_PRICELIST_ID": "4"
  }
}
